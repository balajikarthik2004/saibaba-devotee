# Copy to .env.local (root is fine: both Vite apps read VITE_* from their own folder, so also
# copy to apps/devotee/.env.local and apps/admin/.env.local, or use apps/*/.env.example).
# Only PUBLISHABLE values belong here. Secrets live in Supabase function secrets (supabase/.env.example).

# mock = everything in memory, no backend needed (default). supabase = migrated slices use the repository layer.
VITE_DATA_MODE=mock

# Supabase project (Settings -> API). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge functions base, no trailing slash: https://<project-ref>.supabase.co/functions/v1
VITE_API_BASE=

# Publishable payment identifiers
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=

# Public site URL (canonical links / sharing) and Web Push public key (PWA slice)
VITE_SITE_URL=
VITE_VAPID_PUBLIC_KEY=
