# Edge function secrets. NEVER commit real values and NEVER prefix with VITE_.
# Set with:  supabase secrets set --env-file supabase/.env   (or one by one)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# --- CORS / links
ALLOWED_ORIGINS=https://your-devotee-app.vercel.app,https://your-admin-app.vercel.app
APP_DEVOTEE_URL=https://your-devotee-app.vercel.app
APP_ADMIN_URL=https://your-admin-app.vercel.app

# --- Stripe (cards, wallets, recurring)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # endpoint secret for https://<ref>.supabase.co/functions/v1/payments/stripe/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=     # only if temples use Stripe Connect (a separate "Connect" webhook endpoint)
STRIPE_API_VERSION=2024-06-20
PLATFORM_FEE_BPS=0                 # platform fee in basis points on Connect charges (0 = none)

# --- Razorpay (India: UPI, cards, netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # endpoint https://<ref>.supabase.co/functions/v1/payments/razorpay/webhook

# --- Notifications
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Shree Sai <noreply@your-domain.example>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                   # E.164 sender or use a Messaging Service
TWILIO_WHATSAPP_FROM=              # approved WhatsApp sender, E.164 (without "whatsapp:")

# --- Scheduling
CRON_SECRET=                       # long random string; sent as x-cron-secret by the scheduler
DIGEST_LOCAL_HOUR=7                # daily message goes out after this local hour

# --- Auth providers (referenced from config.toml via env(...))
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_SECRET=
TWILIO_MESSAGE_SERVICE_SID=        # Supabase Auth phone OTP (Twilio Verify / Messaging Service)
